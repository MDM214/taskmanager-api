# =========================================================
# TASKMANAGER - VARIABLES DE ENTORNO
# =========================================================
# Este archivo contiene valores de ejemplo.
# Copia las variables necesarias en tu sistema o proveedor.
# No introduzcas aqui contrasenas ni secretos reales.
# =========================================================

# Base de datos
DB_URL=jdbc:mariadb://localhost:3306/taskmanager
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_password

# Configuración JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Seguridad JWT
JWT_SECRET=escribe-una-clave-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRATION=3600000